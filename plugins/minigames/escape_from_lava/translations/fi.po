msgid "ESCAPE_FROM_LAVA_FINISH_MSG"
msgstr "Maali!"

msgid "MINIGAME_NAME"
msgstr "Pakene laavasta"

msgid "MINIGAME_DESCRIPTION"
msgstr ""
"Pelaajat kilpailevat toisiaan vastaan päästäkseen huipulle, kun laava nousee "
"alla.\n"
"Heidän täytyy kulkea useista ovista. Yksi näistä ovista on tukossa eikä "
"aukea.\n"
"Ensimmäinen pelaaja, joka pääsee turvallisesti huipulle, voittaa!"

msgid "MINIGAME_ACTION_UP"
msgstr "Liiku ylös"

msgid "MINIGAME_ACTION_DOWN"
msgstr "Liiku alas"

msgid "MINIGAME_ACTION_LEFT"
msgstr "Liiku vasemmalle"

msgid "MINIGAME_ACTION_RIGHT"
msgstr "Liiku oikealle"
